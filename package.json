{
  "name": "loreweave",
  "mcpName": "io.github.lets-order-some-fries/loreweave",
  "version": "0.38.0",
  "description": "A temporal knowledge engine for markdown vaults — indexes, links, remembers, forgets, and dreams. Local-first, agent-ready (MCP).",
  "type": "module",
  "license": "MIT",
  "author": "Ambuj Upadhyay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lets-order-some-fries/loreweave.git"
  },
  "keywords": [
    "pkm",
    "knowledge-graph",
    "obsidian",
    "markdown",
    "mcp",
    "memory",
    "rag",
    "personal-knowledge",
    "local-first",
    "temporal"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lore": "./dist/cli/main.js",
    "loreweave": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "npm run build && node eval/run.mjs",
    "eval:gate": "npm run build && node eval/run.mjs --gate",
    "scale": "npm run build && node eval/scale.mjs",
    "bench:beir": "npm run build && node eval/beir.mjs",
    "bench:longmemeval": "npm run build && node --max-old-space-size=8192 eval/longmemeval.mjs",
    "bench:locomo": "npm run build && node eval/locomo.mjs",
    "eval:baseline": "npm run build && node eval/run.mjs --json > eval/baseline.json && echo 'baseline recorded'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "smoke": "bash scripts/smoke-package.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.8.0",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "wink-eng-lite-web-model": "^1.8.0",
    "wink-nlp": "^2.3.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "fast-uri": "^3.1.6",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
